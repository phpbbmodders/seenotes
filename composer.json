{
	"name": "phpbbmodders/seenotes",
	"type": "phpbb-extension",
	"description": "Lets moderators mark a member with a staff-only reason from a list the administrators set, and keep dated notes under each reason.",
	"homepage": "https://www.phpbbmodders.com/",
	"version": "1.0.0-dev",
	"keywords": [
		"phpbb",
		"extension",
		"moderation",
		"moderator",
		"user notes"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "phpBB Modders",
			"email": "board@phpbbmodders.com",
			"homepage": "https://www.phpbbmodders.com/",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=8.3.36",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "See Notes",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.19,<4.1.0@dev"
		}
	}
}
